# Copy to .env (gitignored), fill in, then load it with: source .env
export BAZAAR_URL=https://bazaar.causaprima.ai
export BAZAAR_KEY=tk-xxxx-xxxx      # team key from the slip: the same for the three of us
export ANTHROPIC_API_KEY=           # personal: the $100 event credits
# export BROKER_KEY=bk_...          # once we open a venue (level 2)
# ntfy.sh topics for phone alerts (tools/notify.py). Pick long unguessable names; anyone with the name can read them.
# Empty = alerts go to stderr only.
export NTFY_DANI=
export NTFY_LUCAS=
# The hub (Neon Postgres, hub/README.md): Aleks shares these privately. Writer for collectors/importer/model,
# reader for everything that only reads.
HUB_WRITER_URL=
HUB_READER_URL=
